<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Native C# NFS server hosting surface (ONC RPC, MOUNT v3, NFSv3, NFSv4.x) with a built-in local file system backend, pluggable host capabilities including SETATTR attribute mutation, and an embeddable OpenNfsServerApplication suitable for in-process test servers. Alpha.</Description>
    <IsPackable>true</IsPackable>
    <PackageId>OpenNFS.Server</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Title>OpenNFS.Server</Title>
    <PackageTags>nfs;nfsv3;nfsv4;server;onc-rpc;mount;storage</PackageTags>
    <PackageReleaseNotes>v0.1.1: fixes WriteAllBytesAsync truncation, create-if-missing, short writes, COMMIT/verifier handling, and FSINFO-sized transfers; adds NFSv3 SETATTR (client API and server INfsAttributeMutation capability), ranged/stream reads, stream writes, rename, READDIRPLUS listings, mkdir -p, exists/set-length/set-times, opt-in portmapper discovery, persistent multiplexed TCP connections (no connection per RPC), verbatim path components, explicit CREATE/MKDIR modes, and page-aligned READ chunking for knfsd. See CHANGELOG.md.</PackageReleaseNotes>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeInternalRuntimeBuildOutputInPackage</TargetsForTfmSpecificBuildOutput>
    <TargetsForTfmSpecificDebugSymbolsInPackage>$(TargetsForTfmSpecificDebugSymbolsInPackage);IncludeInternalRuntimeDebugSymbolsInPackage</TargetsForTfmSpecificDebugSymbolsInPackage>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Internal\V42\**\*.cs" />
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="" Link="LICENSE.md" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" Link="README.md" />
  </ItemGroup>
  <ItemGroup>
    <!-- OpenNFS.Server publicly exposes a registration point for IRpcSecGssMechanism so
         consumers can opt their host into RPCSEC_GSS. The project reference gives the
         server source access to the abstraction at compile time; SuppressDependenciesWhenPacking
         keeps OpenNFS.Rpc out of the public package's transitive NuGet dependencies. -->
    <ProjectReference Include="..\OpenNFS.Protocol.V41\OpenNFS.Protocol.V41.csproj" />
    <ProjectReference Include="..\OpenNFS.Rpc\OpenNFS.Rpc.csproj" />
    <InternalRuntimeProject Include="..\OpenNFS.Rpc\OpenNFS.Rpc.csproj" />
    <InternalRuntimeProject Include="..\OpenNFS.Protocol.V3\OpenNFS.Protocol.V3.csproj" />
    <InternalRuntimeProject Include="..\OpenNFS.Protocol.V40\OpenNFS.Protocol.V40.csproj" />
    <InternalRuntimeProject Include="..\OpenNFS.Protocol.V41\OpenNFS.Protocol.V41.csproj" />
    <InternalRuntimeProject Include="..\OpenNFS.Protocol.V42\OpenNFS.Protocol.V42.csproj" />
  </ItemGroup>
  <Target Name="BuildInternalRuntimeProjectsForPackage" Condition="'$(NoBuild)' != 'true'">
    <MSBuild Projects="@(InternalRuntimeProject)"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);BuildProjectReferences=true" />
  </Target>
  <Target Name="IncludeInternalRuntimeBuildOutputInPackage" DependsOnTargets="BuildInternalRuntimeProjectsForPackage">
    <ItemGroup>
      <BuildOutputInPackage Include="..\OpenNFS.Rpc\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Rpc.dll" Condition="Exists('..\OpenNFS.Rpc\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Rpc.dll')" />
      <BuildOutputInPackage Include="..\OpenNFS.Rpc\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Rpc.xml" Condition="Exists('..\OpenNFS.Rpc\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Rpc.xml')" />
      <BuildOutputInPackage Include="..\OpenNFS.Protocol.V3\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Protocol.V3.dll" Condition="Exists('..\OpenNFS.Protocol.V3\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Protocol.V3.dll')" />
      <BuildOutputInPackage Include="..\OpenNFS.Protocol.V3\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Protocol.V3.xml" Condition="Exists('..\OpenNFS.Protocol.V3\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Protocol.V3.xml')" />
      <BuildOutputInPackage Include="..\OpenNFS.Protocol.V40\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Protocol.V40.dll" Condition="Exists('..\OpenNFS.Protocol.V40\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Protocol.V40.dll')" />
      <BuildOutputInPackage Include="..\OpenNFS.Protocol.V40\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Protocol.V40.xml" Condition="Exists('..\OpenNFS.Protocol.V40\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Protocol.V40.xml')" />
      <BuildOutputInPackage Include="..\OpenNFS.Protocol.V41\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Protocol.V41.dll" Condition="Exists('..\OpenNFS.Protocol.V41\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Protocol.V41.dll')" />
      <BuildOutputInPackage Include="..\OpenNFS.Protocol.V41\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Protocol.V41.xml" Condition="Exists('..\OpenNFS.Protocol.V41\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Protocol.V41.xml')" />
      <BuildOutputInPackage Include="..\OpenNFS.Protocol.V42\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Protocol.V42.dll" Condition="Exists('..\OpenNFS.Protocol.V42\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Protocol.V42.dll')" />
      <BuildOutputInPackage Include="..\OpenNFS.Protocol.V42\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Protocol.V42.xml" Condition="Exists('..\OpenNFS.Protocol.V42\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Protocol.V42.xml')" />
    </ItemGroup>
  </Target>
  <Target Name="IncludeInternalRuntimeDebugSymbolsInPackage" DependsOnTargets="BuildInternalRuntimeProjectsForPackage">
    <ItemGroup>
      <TfmSpecificDebugSymbolsFile Include="..\OpenNFS.Rpc\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Rpc.pdb" Condition="Exists('..\OpenNFS.Rpc\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Rpc.pdb')">
        <TargetFramework>$(TargetFramework)</TargetFramework>
      </TfmSpecificDebugSymbolsFile>
      <TfmSpecificDebugSymbolsFile Include="..\OpenNFS.Protocol.V3\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Protocol.V3.pdb" Condition="Exists('..\OpenNFS.Protocol.V3\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Protocol.V3.pdb')">
        <TargetFramework>$(TargetFramework)</TargetFramework>
      </TfmSpecificDebugSymbolsFile>
      <TfmSpecificDebugSymbolsFile Include="..\OpenNFS.Protocol.V40\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Protocol.V40.pdb" Condition="Exists('..\OpenNFS.Protocol.V40\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Protocol.V40.pdb')">
        <TargetFramework>$(TargetFramework)</TargetFramework>
      </TfmSpecificDebugSymbolsFile>
      <TfmSpecificDebugSymbolsFile Include="..\OpenNFS.Protocol.V41\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Protocol.V41.pdb" Condition="Exists('..\OpenNFS.Protocol.V41\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Protocol.V41.pdb')">
        <TargetFramework>$(TargetFramework)</TargetFramework>
      </TfmSpecificDebugSymbolsFile>
      <TfmSpecificDebugSymbolsFile Include="..\OpenNFS.Protocol.V42\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Protocol.V42.pdb" Condition="Exists('..\OpenNFS.Protocol.V42\bin\$(Configuration)\$(TargetFramework)\OpenNFS.Protocol.V42.pdb')">
        <TargetFramework>$(TargetFramework)</TargetFramework>
      </TfmSpecificDebugSymbolsFile>
    </ItemGroup>
  </Target>
</Project>
