{
  "uid": "opennfs-rpc",
  "title": "OpenNFS Server RPC",
  "description": "Per-procedure ONC RPC behavior: rate, status, latency by procedure and stage, payload sizes, authentication, mount decisions, duplicate-request cache, and connections.",
  "tags": [
    "opennfs",
    "rpc"
  ],
  "schemaVersion": 39,
  "timezone": "",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "editable": true,
  "links": [
    {
      "title": "OpenNFS dashboards",
      "type": "dashboards",
      "tags": [
        "opennfs"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
