{
  "uid": "opennfs-nfsv4",
  "title": "OpenNFS NFSv4 and State",
  "description": "NFSv4.x COMPOUND operations and server state: per-operation rate, latency, and status; clients, opens, locks, delegations, leases, grace, sessions, and SEQUENCE slots.",
  "tags": [
    "opennfs",
    "nfsv4",
    "state"
  ],
  "schemaVersion": 39,
  "timezone": "",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "editable": true,
  "links": [
    {
      "title": "OpenNFS dashboards",
      "type": "dashboards",
      "tags": [
        "opennfs"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "COMPOUND Operations",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Operation Rate",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (nfs_minor_version, nfs_operation) (rate(opennfs_server_compound_operation_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "4.{{nfs_minor_version}} {{nfs_operation}}",
          "refId": "A"
        }
      ]
    },
    {
