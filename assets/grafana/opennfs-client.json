{
  "uid": "opennfs-client",
  "title": "OpenNFS Client",
  "description": "OpenNFS.Client inside an application: logical RPC calls and retries, transport attempts, the pooled TCP connection pool, and mounted-session operations. Requires the embedding application to export the OpenNFS.Client meter.",
  "tags": [
    "opennfs",
    "client"
  ],
  "schemaVersion": 39,
  "timezone": "",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "editable": true,
  "links": [
    {
      "title": "OpenNFS dashboards",
      "type": "dashboards",
      "tags": [
        "opennfs"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "RPC",
      "id": 1,
      "collapsed": false,
