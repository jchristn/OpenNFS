{
  "uid": "opennfs-backends",
  "title": "OpenNFS Backends and Integrations",
  "description": "Calls from the protocol layer into host-supplied backends (file system, locking, ACLs, delegations, ID mapping, copy/clone, sparse files, attribute mutation, mount authorization, file handles, exports, RPCSEC_GSS mechanism) and server-originated callbacks. Use it to tell whether slowness is the storage backend or the protocol.",
  "tags": [
    "opennfs",
    "backends",
    "integrations"
  ],
  "schemaVersion": 39,
  "timezone": "",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "editable": true,
  "links": [
    {
      "title": "OpenNFS dashboards",
      "type": "dashboards",
      "tags": [
        "opennfs"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Backends",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Call Rate by Capability",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (opennfs_capability) (rate(opennfs_server_backend_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{opennfs_capability}}",
          "refId": "A"
        }
      ]
    },
