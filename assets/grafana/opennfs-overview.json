{
  "uid": "opennfs-overview",
  "title": "OpenNFS Overview",
  "description": "One-glance health of the OpenNFS server: liveness, request rate, failure ratio, latency, and connection load. Start here, then drill into the domain dashboards.",
  "tags": [
    "opennfs",
    "overview"
  ],
  "schemaVersion": 39,
  "timezone": "",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "editable": true,
  "links": [
    {
      "title": "OpenNFS dashboards",
      "type": "dashboards",
      "tags": [
        "opennfs"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Health",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Server Up",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Running OpenNfsServerApplication instances (opennfs.server.up).",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(opennfs_server_up)",
          "legendFormat": "",
          "refId": "A",
          "instant": false
        }
      ]
    },
    {
      "type": "stat",
      "title": "Version",
      "id": 3,
      "datasource": {
        "type": "prometheus",
